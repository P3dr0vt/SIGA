# Vercel: use o Transaction pooler do Supabase (porta 6543).
# Infraestrutura local: use a URL do PostgreSQL local.
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=https://seu-projeto.vercel.app

# Usadas somente ao executar npm run create-admin
ADMIN_EMAIL=administrador@senai.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador GERA

# Apenas para o PostgreSQL do Docker local
POSTGRES_PASSWORD=gere-uma-senha-local-forte
