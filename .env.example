# Configuracao legada usada enquanto o backend ainda estiver em MySQL.
# Substituir por DATABASE_URL na migracao para PostgreSQL/Supabase.
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_USER=gera_app
DB_PASSWORD=use-uma-senha-forte-e-exclusiva
DB_NAME=siga_db
DB_SSL=true
DB_CONNECTION_LIMIT=5
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
ALLOWED_ORIGINS=https://seu-projeto.vercel.app

# Apenas para o ambiente Docker local
MYSQL_ROOT_PASSWORD=gere-uma-senha-local-forte

# Usadas somente ao executar npm run create-admin
ADMIN_EMAIL=administrador@senai.com
ADMIN_PASSWORD=troque-por-uma-senha-forte
ADMIN_NAME=Administrador GERA
